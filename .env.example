# Tugobo Lead Engine — environment template
#
# Copy to .env.local and fill in. NEVER commit real values; .env.local is
# git-ignored and this template must stay empty.
#
# For the auth keys, do not edit them by hand — run:
#
#   pnpm auth:setup
#
# which prompts for your e-mail and password, writes a bcrypt hash, and
# generates AUTH_SECRET. Your plaintext password is never stored.

# ─── Single-admin authentication (required in production) ──────────────────
# Without all three of these, login always fails and the app stays locked.

# The one admin e-mail. Compared case-insensitively.
LEAD_ENGINE_ADMIN_EMAIL=

# bcrypt hash of the admin password, BASE64-ENCODED. The plaintext password is
# NEVER stored. It is base64-encoded because a raw bcrypt hash contains "$"
# characters that Next.js's dotenv-expand would otherwise corrupt on load.
# `pnpm auth:setup` writes this in the correct form; app/lib/auth/env.ts decodes
# it (and still accepts a raw bcrypt hash set directly as an env var, e.g. on the VPS).
LEAD_ENGINE_ADMIN_PASSWORD_HASH=

# Session signing secret. Generate a strong random value (pnpm auth:setup does).
# Changing this invalidates all existing sessions.
AUTH_SECRET=

# Required when running behind the Nginx reverse proxy on the VPS.
AUTH_TRUST_HOST=true

# ─── Demo / seed data safety ───────────────────────────────────────────────
# The bundled sample hotels are seed data, not real leads.
# Development always shows them. Production hides them unless this is
# exactly "true", so demo records can never be worked as real pipeline.
LEAD_ENGINE_ALLOW_DEMO_DATA=false

# ─── Operational state storage (required in production) ────────────────────
# Absolute path to the directory holding operational-state.json: the founder's
# queue, sales stages, follow-up dates, notes and activity history.
#
# MUST point OUTSIDE the repository checkout, or a deploy will delete the
# pipeline. Create it and give the PM2 user write access — see
# docs/HOSTINGER_DATA_STORAGE.md.
#
#   LEAD_ENGINE_DATA_DIR=/var/lib/tugobo-lead-engine
#
# Leave blank in development: the app falls back to .data/ in the project root,
# which is git-ignored.
LEAD_ENGINE_DATA_DIR=

# ─── Existing integrations (unchanged by the auth sprint) ──────────────────

GOOGLE_MAPS_API_KEY=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=
DEEPSEEK_API_KEY=
